rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidHouse(house) {
      return house in ['Gryffindor', 'Slytherin', 'Ravenclaw', 'Hufflepuff'];
    }

    function isValidBloodStatus(blood) {
      return blood in ['Pure-blood', 'Half-blood', 'Muggle-born', 'Squib', 'Magical Heritage'];
    }

    function isValidWizard(data, userId) {
      return data.keys().hasAll([
        'uid', 'name', 'age', 'house', 'school', 'bloodStatus',
        'wandCore', 'wandWood', 'spellLockHash', 'spellLockSalt',
        'spellLockHint', 'duelWins', 'duelLosses', 'umbridgeDefeatedCount',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'name', 'age', 'house', 'school', 'bloodStatus',
        'wandCore', 'wandWood', 'spellLockHash', 'spellLockSalt',
        'spellLockHint', 'duelWins', 'duelLosses', 'umbridgeDefeatedCount',
        'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == request.auth.uid && data.uid == userId
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.age is int && data.age >= 5 && data.age <= 150
      && data.house is string && isValidHouse(data.house)
      && data.school is string && data.school.size() >= 1 && data.school.size() <= 80
      && data.bloodStatus is string && isValidBloodStatus(data.bloodStatus)
      && data.wandCore is string && data.wandCore.size() >= 1 && data.wandCore.size() <= 80
      && data.wandWood is string && data.wandWood.size() >= 1 && data.wandWood.size() <= 60
      && data.spellLockHash is string && data.spellLockHash.size() <= 128
      && data.spellLockSalt is string && data.spellLockSalt.size() <= 64
      && data.spellLockHint is string && data.spellLockHint.size() <= 120
      && data.duelWins is int && data.duelWins >= 0 && data.duelWins <= 1000000
      && data.duelLosses is int && data.duelLosses >= 0 && data.duelLosses <= 1000000
      && data.umbridgeDefeatedCount is int && data.umbridgeDefeatedCount >= 0 && data.umbridgeDefeatedCount <= 1000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidDiaryEntry(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'title', 'content', 'isEncrypted', 'iv',
        'fontFamily', 'inputMode', 'moodTag', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'title', 'content', 'isEncrypted', 'iv',
        'fontFamily', 'inputMode', 'moodTag', 'createdAt', 'updatedAt'
      ])
      && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
      && data.content is string && data.content.size() >= 1 && data.content.size() <= 20000
      && data.isEncrypted is bool
      && data.iv is string && data.iv.size() <= 64
      && data.fontFamily is string && data.fontFamily.size() >= 1 && data.fontFamily.size() <= 60
      && data.inputMode is string && data.inputMode in ['typed', 'handwritten', 'mixed']
      && data.moodTag is string && data.moodTag.size() >= 1 && data.moodTag.size() <= 40
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidScrollQuery(data, userId) {
      return data.keys().hasAll(['ownerId', 'question', 'answer', 'sourceType', 'createdAt'])
      && data.keys().hasOnly(['ownerId', 'question', 'answer', 'sourceType', 'createdAt'])
      && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
      && data.question is string && data.question.size() >= 1 && data.question.size() <= 500
      && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 8000
      && data.sourceType is string && data.sourceType in ['diary', 'web', 'hybrid']
      && data.createdAt is timestamp;
    }

    function hasWizardParent(userId) {
      return exists(/databases/$(database)/documents/wizards/$(userId))
        && get(/databases/$(database)/documents/wizards/$(userId)).data.uid == request.auth.uid;
    }

    match /wizards/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidWizard(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidWizard(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update character identity details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'age', 'house', 'school', 'bloodStatus', 'wandCore', 'wandWood', 'updatedAt'
          ]) ||
          // Action 2: Set or update diary lock spell password
          incoming().diff(existing()).affectedKeys().hasOnly([
            'spellLockHash', 'spellLockSalt', 'spellLockHint', 'updatedAt'
          ]) ||
          // Action 3: Record duel combat statistics
          incoming().diff(existing()).affectedKeys().hasOnly([
            'duelWins', 'duelLosses', 'umbridgeDefeatedCount', 'updatedAt'
          ])
        );

      allow delete: if false;

      match /entries/{entryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidDiaryEntry(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasWizardParent(userId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidDiaryEntry(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && hasWizardParent(userId)
          && (
            // Action 1: Edit manuscript entry or re-encrypt under lock spell
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'content', 'isEncrypted', 'iv', 'fontFamily', 'inputMode', 'moodTag', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && hasWizardParent(userId);
      }

      match /scrollQueries/{queryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(queryId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(queryId)
          && isValidScrollQuery(incoming(), userId)
          && incoming().createdAt == request.time
          && hasWizardParent(userId);

        allow update: if false;

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(queryId)
          && hasWizardParent(userId);
      }
    }
  }
}
